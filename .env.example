# Copy to .env and fill in. Everything is optional — with no config the app runs
# in dry-run mode and writes every email to instance/outbox/ instead of sending.

# --- Security ---
OUTREACH_SECRET_KEY=change-me-to-a-long-random-string
# Require a password to open the UI (recommended whenever it's on the internet)
OUTREACH_PASSWORD=
# Enables /api/v1/leads and /api/v1/events (send as X-API-Key header)
OUTREACH_API_KEY=

# --- Storage ---
# OUTREACH_DB=instance/outreach.db

# --- Sending (SMTP) ---
# dryrun (default) | smtp
OUTREACH_MAIL_BACKEND=dryrun
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# starttls (587) | ssl (465) | none
SMTP_SECURITY=starttls
SMTP_USER=you@yourdomain.com
# Gmail/Workspace: create an App Password (requires 2FA)
SMTP_PASSWORD=

# --- Reply & bounce detection (IMAP) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@yourdomain.com
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
